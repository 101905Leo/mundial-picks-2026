generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum LeagueRole {
  MEMBER
  ADMIN
}

model User {
  id             String             @id @default(cuid())
  name           String
  phone          String             @unique
  passwordHash   String
  role           Role               @default(USER)
  isActive       Boolean            @default(false)
  entryPaidAt    DateTime?
  entryPayments  EntryPayment[]
  predictions    Prediction[]
  leagues        LeagueMembership[]
  ownedLeagues   League[]           @relation("LeagueOwner")
  leagueMessages LeagueMessage[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model EntryPayment {
  id            String    @id @default(cuid())
  userId        String
  reference     String    @unique
  transactionId String?
  status        String    @default("PENDING")
  amountInCents Int
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
}

model Match {
  id            String       @id @default(cuid())
  sourceKey     String?      @unique
  homeTeam      String
  awayTeam      String
  group         String?
  venue         String?
  broadcastUrl  String?
  startsAt      DateTime
  homeScore     Int?
  awayScore     Int?
  status        MatchStatus  @default(SCHEDULED)
  isPublished   Boolean      @default(false)
  competitionId String?
  roomId        String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  room          League?      @relation("RoomMatches", fields: [roomId], references: [id], onDelete: Cascade)
  predictions   Prediction[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([competitionId])
  @@index([roomId])
}

model Prediction {
  id           String    @id @default(cuid())
  userId       String
  matchId      String
  homeScore    Int
  awayScore    Int
  points       Int       @default(0)
  manualPoints Int?
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model League {
  id              String             @id @default(cuid())
  name            String
  inviteCode      String             @unique
  ownerId         String
  competitionId   String?
  maxParticipants Int                @default(20)
  paymentReference String?           @unique
  paymentStatus    String            @default("PENDING")
  paymentAmountInCents Int           @default(0)
  paidAt          DateTime?
  owner           User               @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  competition     Competition?       @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  memberships     LeagueMembership[]
  messages        LeagueMessage[]
  matches         Match[]            @relation("RoomMatches")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([competitionId])
}

model Competition {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  country   String?
  season    String
  isActive  Boolean  @default(true)
  leagues   League[]
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeagueMembership {
  id       String   @id @default(cuid())
  userId   String
  leagueId String
  role     LeagueRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
  @@index([leagueId])
}

model LeagueMessage {
  id            String   @id @default(cuid())
  leagueId      String
  userId        String
  body          String
  audioData     String?
  audioMime     String?
  audioDuration Int?
  createdAt     DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
  @@index([userId])
}
